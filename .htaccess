# VOSTOKPRIBOR AI Security & Routing Configuration

# Prevent directory browsing
Options -Indexes

# Protect sensitive files and directories
<FilesMatch "^\.env|\.git|\.md$|composer\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect private directories
RewriteEngine On

# One canonical SOC dashboard; keep old bookmarks without a second PHP entry.
RewriteCond %{REQUEST_URI} ^(.*/)OperationsDashboard\.php$
RewriteRule "^AI Operations Center \(AI SOC\)/OperationsDashboard\.php$" "%1Dashboard.php" [R=308,L]

# Block direct access to sensitive folders
RewriteRule ^(app|config|database|db|storage|bin|workers|tests|\.git)(/|$) - [F,L,NC]
RewriteRule ^api/v1/modules(/|$) - [F,L,NC]

# Route API v1 requests to API Front Controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/v1/(.*)$ api/v1/index.php [QSA,L]
