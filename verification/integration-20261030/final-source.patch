+            'file_size'=>$file['file_size'],'checksum_sha256'=>$file['checksum_sha256'],'row_count'=>$file['row_count'],
+            'column_count'=>$file['column_count'],'schema_json'=>json_encode($file['schema_json'],JSON_THROW_ON_ERROR)
