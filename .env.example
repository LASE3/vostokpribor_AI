# VOSTOKPRIBOR AI - local XAMPP example; copy to .env (never ship that file)
APP_NAME="VOSTOKPRIBOR AI"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/vostokpribor_AI

# Explicit database configuration is required. Use a NEW name for each installation.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vostok_range_local_01
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# For public HTTPS deployments use APP_ENV=production, SESSION_SECURE=true,
# a restricted runtime database account, and a strong rotated administrator password.
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_COOKIE_NAME=vostok_range_local_01
MAX_UPLOAD_SIZE_MB=50

# Execution is deliberately disabled in PHP and in both worker entry points.
# No environment setting can enable host execution.

# Optional absolute path OUTSIDE the project/web root to private Colab Enterprise
# configuration. A configured adapter remains disabled until live isolation and
# provider acceptance are implemented/verified. Never place Google secrets here.
COLAB_CONFIG_FILE=

# Shared authenticated API/HTML write admission.
API_MUTATION_LIMIT=120
API_UPLOAD_LIMIT=20
API_RATE_WINDOW_SECONDS=60
# File-heavy/unbounded catalog/summary GETs share this per-user bucket across
# central API, legacy endpoints and selected HTML views. Ordinary GET/auth/me/
# auth/csrf/HEAD/OPTIONS remain uncounted; no work records are created by reads.
API_EXPENSIVE_READ_LIMIT=60

# HTTP boot validates configuration types/ranges and fails closed on bad settings.
# Production additionally requires HTTPS APP_URL + real HTTPS, APP_DEBUG=false,
# SESSION_SECURE=true, a non-root DB_USER and non-empty DB_PASS. This file is
# local-only; never copy local root/blank-password settings to production.
# HTTPS must be indicated by the trusted webserver, not forwarded client headers.
