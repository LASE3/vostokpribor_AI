# VOSTOKPRIBOR AI Engineering Range Configuration
APP_NAME="VOSTOKPRIBOR AI"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/vostokpribor_AI

# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vostokpribor_ai
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_COOKIE_NAME=vostok_ai_session
CSRF_TOKEN_NAME=vostok_csrf_token

# Storage Configuration (Private storage outside public web root or protected by .htaccess)
STORAGE_PATH="storage/private"
MAX_UPLOAD_SIZE_MB=50

# Python Sandbox Execution Configuration
PYTHON_EXECUTABLE="python"
PYTHON_SANDBOX_TIMEOUT_SEC=30
PYTHON_WORKER_POLL_INTERVAL=2
