# VOSTOKPRIBOR AI - local XAMPP example; copy to .env (never ship that file)
APP_NAME="VOSTOKPRIBOR AI"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/vostokpribor_AI

# Explicit database configuration is required. Use a NEW name for each installation.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vostok_range_local_01
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# For public HTTPS deployments use APP_ENV=production, SESSION_SECURE=true,
# a restricted runtime database account, and a strong rotated administrator password.
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_COOKIE_NAME=vostok_range_local_01
MAX_UPLOAD_SIZE_MB=50

# Execution is deliberately disabled in PHP and in both worker entry points.
# No environment setting can enable host execution.
