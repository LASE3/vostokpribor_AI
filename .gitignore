# Environment secrets
.env
.env.*
!.env.example
*.env

# Database exports and private operational backups (schema migrations are source)
*.sql
!database/migrations/*.sql
*.sql.gz
*.sql.zip
/backups/
*.bak
*.backup
*.log
*.zip
*.tar
*.gz

# New generated evidence stays local and ships in a separate reviewed archive.
# Existing tracked historical evidence is preserved.
/verification/

# Storage and Private User Data
/storage/private/datasets/*
!/storage/private/datasets/.gitkeep
/storage/private/sandboxes/*
!/storage/private/sandboxes/.gitkeep
/storage/private/models/*
!/storage/private/models/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Vendor and Dependencies
/vendor/
node_modules/
__pycache__/
*.pyc

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
/tests/test_output/
/.vostok-test-storage
